      <column caption='Year' datatype='string' name='[Calculation_2538904354714574848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Wine Name], [Winery]) THEN&#10;    IF LEN(TRIM(REPLACE([Wine Name], [Winery], &quot;&quot;))) = 2 THEN&#10;        &quot;20&quot; + TRIM(REPLACE([Wine Name], [Winery], &quot;&quot;))&#10;    ELSE&#10;        LEFT(TRIM(REPLACE([Wine Name], [Winery], &quot;&quot;)), 4)&#10;    END&#10;ELSE&#10;    NULL&#10;END' />
      </column>
